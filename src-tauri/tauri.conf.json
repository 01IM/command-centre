{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Centre",
  "version": "1.0.0",
  "identifier": "com.imranali.commandcentre",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Command Centre",
        "width": 1536,
        "height": 824,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Imran M. Ali",
    "shortDescription": "Personal dashboard",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}